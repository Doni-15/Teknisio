<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootOnboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7FA">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/onboarding_1"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.55"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/TeknisioOnboardingImageShape" />

    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_indicator_pill"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:translationY="14dp"
        app:layout_constraintBottom_toBottomOf="@id/imgOnboarding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot1"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:background="@drawable/bg_dot_active" />

        <View
            android:id="@+id/dot2"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:id="@+id/dot3"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/bg_dot_inactive" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="42dp"
        android:paddingTop="44dp"
        android:paddingEnd="42dp"
        android:paddingBottom="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgOnboarding">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="Teknisio Logo"
            android:src="@drawable/logo_teknisio"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/txtBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:letterSpacing="0.13"
            android:shadowColor="#553A4A8A"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="4"
            android:text="TEKNISIO"
            android:textColor="#4F70D9"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="Your Service Solution"
            android:textColor="#1F2329"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_start_button"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="Start"
            android:textAllCaps="false"
            android:textColor="#BDECEC"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
