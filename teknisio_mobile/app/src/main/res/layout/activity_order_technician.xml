<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootOrderScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="38dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include layout="@layout/component_back_button" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="Pesan Teknisi"
                android:textColor="#1F2329"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Teknisi"
            android:textColor="#1F2329"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_order_icon_circle"
                android:gravity="center"
                android:text="T"
                android:textColor="#2F4A8A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTechnicianName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teknisi"
                    android:textColor="#1F2329"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTechnicianMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Memuat data teknisi..."
                    android:textColor="#6B7680"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Kategori Perangkat"
            android:textColor="#1F2329"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSelectedSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Dipilih: -"
            android:textColor="#1F2329"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutSelectedCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Deskripsi Kerusakan"
            android:textColor="#1F2329"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtIssueDescription"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_input"
            android:gravity="top|start"
            android:hint="Contoh: AC tidak dingin dan berisik"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:padding="14dp"
            android:textColor="#1F2329"
            android:textColorHint="#8A949B"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Alamat Servis"
            android:textColor="#1F2329"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAddress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_input"
            android:hint="Alamat utama"
            android:inputType="textPostalAddress|textCapSentences"
            android:maxLength="500"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1F2329"
            android:textColorHint="#8A949B"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtAddressDetail"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_input"
            android:gravity="top|start"
            android:hint="Detail alamat opsional, contoh: rumah pagar hitam"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:padding="14dp"
            android:textColor="#1F2329"
            android:textColorHint="#8A949B"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_order_primary_disabled"
            android:backgroundTint="@null"
            android:text="Konfirmasi Pesanan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
