<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootOrderScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="38dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="58dp">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_order_back"
                android:elevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#2F4A8A"
                    android:textSize="38sp" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Order Technician"
                android:textColor="#1F2329"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Technician"
            android:textColor="#1F2329"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_order_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_order_icon_circle"
                android:gravity="center"
                android:text="T"
                android:textColor="#2F4A8A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTechnicianName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Teknisi"
                    android:textColor="#1F2329"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTechnicianMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Memuat data teknisi..."
                    android:textColor="#6B7680"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Selected Category"
            android:textColor="#1F2329"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutSelectedCategory"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_order_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_order_icon_circle">

                <ImageView
                    android:id="@+id/imgCategoryIcon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:tint="#2F4A8A" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtCategoryName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:text="Category"
                android:textColor="#1F2329"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSelectedSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Dipilih: -"
            android:textColor="#1F2329"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutSelectedCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Describe Damages"
            android:textColor="#1F2329"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtIssueDescription"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_order_input"
            android:gravity="top|start"
            android:hint="Contoh: AC tidak dingin dan keluar suara berisik"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="1000"
            android:padding="16dp"
            android:textColor="#1F2329"
            android:textColorHint="#8A949B"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Service Address"
            android:textColor="#1F2329"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtAddress"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_order_input"
            android:hint="Alamat utama"
            android:inputType="textPostalAddress|textCapSentences"
            android:maxLength="500"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#1F2329"
            android:textColorHint="#8A949B"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/edtAddressDetail"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_input"
            android:gravity="top|start"
            android:hint="Detail alamat opsional, contoh: rumah pagar hitam"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="500"
            android:padding="16dp"
            android:textColor="#1F2329"
            android:textColorHint="#8A949B"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_order_primary"
            android:text="Confirm Order"
            android:textAllCaps="false"
            android:textColor="#D4FFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
