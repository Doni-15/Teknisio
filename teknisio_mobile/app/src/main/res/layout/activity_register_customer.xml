<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRegisterScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7FA"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="46dp"
        android:paddingBottom="36dp">

        <ImageView
            android:id="@+id/imgRegisterLogo"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:contentDescription="Teknisio Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_teknisio" />

        <TextView
            android:id="@+id/txtRegisterBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:shadowColor="#303A4A8A"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="TEKNISIO"
            android:textColor="#4E6FDB"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRegisterSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="Create your account"
            android:textColor="#1F2329"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutRoleTabs"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="34dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTabCustomer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_role_tab_active"
                android:gravity="center"
                android:text="Customer"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTabTechnician"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_role_tab_inactive"
                android:gravity="center"
                android:text="Teknisi"
                android:textColor="#2F4A8A"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRegisterForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/edtName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Full name"
                android:inputType="textPersonName"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#1F2329"
                android:textColorHint="#A6ABB1"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#1F2329"
                android:textColorHint="#A6ABB1"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtPhone"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Phone number"
                android:inputType="phone"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#1F2329"
                android:textColorHint="#A6ABB1"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#1F2329"
                android:textColorHint="#A6ABB1"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtAddress"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_auth_input"
                android:gravity="top"
                android:hint="Address"
                android:inputType="textMultiLine"
                android:padding="18dp"
                android:textColor="#1F2329"
                android:textColorHint="#A6ABB1"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/layoutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/edtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_auth_input"
                    android:gravity="top"
                    android:hint="Technician description"
                    android:inputType="textMultiLine"
                    android:padding="18dp"
                    android:textColor="#1F2329"
                    android:textColorHint="#A6ABB1"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_start_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="#E5FFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Already have account? Login now"
            android:textColor="#1F2329"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
