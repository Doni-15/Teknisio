<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7FA"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="60dp"
        android:paddingBottom="42dp">

        <ImageView
            android:id="@+id/imgLoginLogo"
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:contentDescription="Teknisio Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_teknisio" />

        <TextView
            android:id="@+id/txtLoginBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:shadowColor="#303A4A8A"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="TEKNISIO"
            android:textColor="#4E6FDB"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLoginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="Your Service Solution"
            android:textColor="#1F2329"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="58dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#1F2329"
                android:textSize="19sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Enter your Email"
                android:inputType="textEmailAddress"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#1F2329"
                android:textColorHint="#A6ABB1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtPasswordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Password"
                android:textColor="#1F2329"
                android:textSize="19sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_auth_input"
                android:hint="Enter your Password"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="#1F2329"
                android:textColorHint="#A6ABB1"
                android:textSize="16sp" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/bg_start_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="Masuk"
            android:textAllCaps="false"
            android:textColor="#E5FFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGoRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Did not have account? Register now"
            android:textColor="#1F2329"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
