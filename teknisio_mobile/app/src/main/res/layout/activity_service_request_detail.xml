<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootServiceRequestDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="38dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include layout="@layout/component_back_button" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Detail Pesanan"
                android:textColor="#1F2329"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtOrderCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REQ-"
                android:textColor="#1F2329"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Waiting"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtOrderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Waktu request"
                android:textColor="#6B7680"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutOrderTechnicianSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Teknisi yang Mengerjakan"
                android:textColor="#1F2329"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtOrderTechnicianName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Memuat data teknisi..."
                android:textColor="#243B7A"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtOrderTechnicianMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="-"
                android:textColor="#6B7680"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtOrderTechnicianCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="-"
                android:textColor="#5F6B73"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Kategori Perangkat"
            android:textColor="#1F2329"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOrderCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_card"
            android:padding="16dp"
            android:text="-"
            android:textColor="#5F6B73"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Deskripsi Kerusakan"
            android:textColor="#1F2329"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOrderIssue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="-"
            android:textColor="#5F6B73"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Alamat Servis"
            android:textColor="#1F2329"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtOrderAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text="-"
            android:textColor="#5F6B73"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtCancelReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_order_card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:text=""
            android:textColor="#C62828"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutCompletionSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ringkasan Penyelesaian"
                android:textColor="#1F2329"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Biaya akhir"
                android:textColor="#6B7680"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtFinalCostValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rp0"
                android:textColor="#243B7A"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCompletionSummaryNoteLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Catatan teknisi"
                android:textColor="#6B7680"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtCompletionSummaryNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F7FAFC"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="-"
                android:textColor="#5F6B73"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStatusHistoryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Riwayat Status"
            android:textColor="#1F2329"
            android:textSize="19sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutStatusHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_order_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtDetailMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="start"
            android:text=""
            android:textColor="#6B7680"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelOrder"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_logout_button"
            android:backgroundTint="@null"
            android:text="Batalkan Pesanan"
            android:textAllCaps="false"
            android:textColor="#FF5A5A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWriteReview"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_order_primary"
            android:backgroundTint="@null"
            android:text="Tulis Ulasan"
            android:textAllCaps="false"
            android:textColor="#D4FFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- GPS Tracking button — visible when status is ACCEPTED -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTrackTechnician"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_order_primary"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_location_pin"
            android:drawablePadding="8dp"
            android:text="🗺 Lacak Teknisi"
            android:textAllCaps="false"
            android:textColor="#D4FFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Chat button — visible when status is ACCEPTED or ON_PROGRESS -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnOpenChat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_card"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_chat"
            android:drawablePadding="8dp"
            android:text="💬 Chat Teknisi"
            android:textAllCaps="false"
            android:textColor="#2F4A8A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
