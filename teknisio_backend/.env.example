APP_NAME=teknisio-backend
PORT=8080
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=teknisio_db
POSTGRES_USER=teknisio_user
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional rate-limit tuning. Defaults are suitable for a local demo.
AUTH_LOGIN_RATE_CAPACITY=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTRATION_RATE_CAPACITY=10
AUTH_REGISTRATION_RATE_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_MAX_CLIENTS=10000
